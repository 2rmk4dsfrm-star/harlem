// Cloudflare Workers settings for harlemgroup.co.uk.
// The site is plain files, so Cloudflare just serves them as they are.
// Files listed in .assetsignore (tools, docs, README and so on) are never published.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "harlem",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": ".",
    // /leeds/ serves leeds/index.html, and /leeds redirects to /leeds/
    "html_handling": "auto-trailing-slash"
  }
}
